# PostgreSQL 连接串（Nitro 服务端读取，runtimeConfig.databaseUrl）
# 未配置时 /api/news 自动回退 data/*.ts 静态数据，站点可正常开发
NUXT_DATABASE_URL=postgres://postgres:postgres@localhost:5433/deeptrols

# 管理后台（Phase 3）：登录密码 + session 加密密码（≥32 位随机串，可用 openssl rand -hex 32 生成）
# 未配置时 /api/admin/* 返回 503，/admin 页面不可用
NUXT_ADMIN_PASSWORD=
NUXT_SESSION_PASSWORD=

# 限流来源 IP 信任开关（登录/leads 防爆破限流 key）：默认 false，只取 TCP socket 对端地址，
# 客户端自带的 X-Forwarded-For 不参与限流 key（防止每次请求更换 XFF 绕过限流）。
# 仅当 Nitro 位于会覆写 XFF 的可信反向代理（nginx / CDN 等）之后时才可设为 true，此时回退取 XFF 首项。
NUXT_RATE_LIMIT_TRUST_PROXY=false

# 媒体上传落盘 / 直出根目录（server/utils/storage.ts 与 GET /uploads/** 路由共用）。
# 默认 <cwd>/public/uploads。生产 Nitro(node-server) 的静态资产是构建期快照 .output/public，
# 运行时新写入的文件不在快照内、且容器重建即丢，因此 /uploads/** 走运行时路由从本目录直出。
# 生产建议将本变量指向持久化挂载卷（如 /data/uploads），避免上传文件随容器丢失。
NUXT_UPLOADS_DIR=
